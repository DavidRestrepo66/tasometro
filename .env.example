# Copy to .env and fill in. .env is git-ignored and configures Docker Compose only.
# The ingestion CLI and dbt read process environment variables: export
# WAREHOUSE_DSN, WAREHOUSE_PASSWORD and SOCRATA_APP_TOKEN before running them.

# Postgres (one instance; databases airflow, warehouse and metabase)
POSTGRES_USER=tasometro
POSTGRES_PASSWORD=change-me
# Changing the password after the first start does not update the existing role.

# Rotate it without deleting the volume. .env is not exported to your shell, so run
# `export POSTGRES_USER=<value from .env>` first, then this single line:
#   docker compose exec postgres psql -U "$POSTGRES_USER" -d postgres -c "ALTER ROLE $POSTGRES_USER PASSWORD '<new>'"
# Finally update POSTGRES_PASSWORD in .env.
POSTGRES_HOST_PORT=5432

# Metabase
METABASE_HOST_PORT=3000

# Socrata app token (optional, raises rate limits): https://dev.socrata.com/docs/app-tokens
SOCRATA_APP_TOKEN=

# Airflow
# Fernet key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# JWT secret: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
# Host user id: run `id -u` and put the result here, so bind mounts keep your ownership
AIRFLOW_UID=1000
AIRFLOW_HOST_PORT=8080

# Metabase admin created by metabase/provision.py (pick a long, unique password)
METABASE_ADMIN_EMAIL=admin@tasometro.local
METABASE_ADMIN_PASSWORD=
