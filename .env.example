# Copy to .env and fill in. .env is git-ignored and is the only config source.

# Postgres (one instance; databases airflow, warehouse and metabase)
POSTGRES_USER=tasometro
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# Metabase
METABASE_HOST_PORT=3000

# Socrata app token (optional, raises rate limits): https://dev.socrata.com/docs/app-tokens
SOCRATA_APP_TOKEN=

# Airflow
# Fernet key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# JWT secret: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
# Host user id (id -u) so bind mounts keep your ownership
AIRFLOW_UID=50000
AIRFLOW_HOST_PORT=8080

# Metabase admin created by metabase/provision.py (pick a long, unique password)
METABASE_ADMIN_EMAIL=admin@tasometro.local
METABASE_ADMIN_PASSWORD=
